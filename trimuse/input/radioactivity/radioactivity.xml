<?xml version="1.0" encoding="UTF-8"?>
<radioactivity>
    <!-- 一张卡处理一个核素，半衰期换算为 s -->
    <parameters>
        <parameter name="nuclide_name" value="Cs137" unit="[1]" si_unit="[1]"/>
        <parameter name="half_life" value="30.05" unit="[year]" si_unit="[s]"/>
    </parameters>
    <initial>
        <!-- inventory 是区域总盘存，单位换算到 atom -->
        <concentration region="residual" model="uniform_from_inventory">
            <parameter name="inventory" value="[float]" unit="[atom]" si_unit="[atom]"/>
        </concentration>
    </initial>
    <regions>
        <!-- capacity 用于瞬态项，decay 用于衰变项，两者独立配置 -->
        <!-- 省略 decay 的区域不组装衰变，pur_decay 根据 half_life 计算衰变系数 -->
        <!-- 省略 source 的区域无源，volumetric_nuclide_birth_rate 读取属性卡 -->
        <region name="residual">
            <model name="diffusion" model_name="fick"/>
            <model name="capacity" model_name="unit"/>
            <model name="decay" model_name="pur_decay"/>
        </region>
    </regions>
    <boundaries>
        <!-- 省略的外边界为零核素通量；另可选 dirichlet 或 neumann -->
        <!-- robin 读取属性卡同名分区的环境核素浓度和传质系数 -->
        <boundary name="[str]">
            <model name="nuclide_boundary" model_name="robin"/>
        </boundary>
    </boundaries>
    <interfaces>
        <!-- 省略的内部界面默认完美接触 -->
        <interface name="residual">
            <model name="interface_nuclide_transfer" model_name="perfect_contact"/>
        </interface>
    </interfaces>
</radioactivity>
