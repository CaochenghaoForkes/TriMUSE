<?xml version="1.0" encoding="UTF-8"?>
<!-- 填写占位符后使用, 可选值只选一项 -->
<trimuse_chief name="[str]">
    <!-- 整个算例共用的随机种子 -->
    <random seed="[int]"/>
    <!-- 相对路径以本卡所在目录为基准, 实际输出到该目录/seed_<随机种子>/ -->
    <output directory="[str]"/>
    <!-- 可省略, 默认 ask; run 仅在空目录计算, postprocess 只处理已有完整结果 -->
    <workflow mode="[ask][run][postprocess]"/>
    <input_files>
        <!-- 子卡相对路径以本卡所在目录为基准, file 留空时生成对应模板并退出 -->
        <geometry_mesh file="[str]"/>
        <material file="[str]"/>
        <properties file="[str]"/>
        <!-- 热卡和放射性卡平级可选, 按本次问题需要添加 -->
        <!-- <thermal file="thermal.xml"/> -->
        <!-- <radioactivity file="radioactivity.xml"/> -->
        <simulation file="[str]"/>
        <postprocess file="[str]"/>
    </input_files>
</trimuse_chief>
