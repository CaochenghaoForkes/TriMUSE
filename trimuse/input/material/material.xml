<?xml version="1.0" encoding="UTF-8"?>
<material>
    <!-- mat 可重复, 材料名称自定, 同一材料可被多个区域引用 -->
    <mat name="[str]">
        <!-- 同一物性只保留一种模型；替代写法均列于注释中。参数 unit 可换算，si_unit 按示例保持。 -->
        <thermal>
            <!-- model 填写注册的模型名称, 无参数时删除 parameter 子节点 -->
            <!-- 参数统一使用子节点, 参数名不可重复 -->
            <!-- common.constant 的参数名为 constant_value -->
            <conductivity model="[common.constant][common.time_series][kernel.bison_2021_uco][kernel.ineri_2004_uo2][buffer.bison_2021][buffer.uk_2004][sic.miller][sic.cea_2004]">
                <!-- parameter 可重复, unit 为输入单位, si_unit 必须符合模型要求的内部单位 -->
                <!-- common.constant 可只保留一个名为 constant_value 的 parameter -->
                <!-- 无量纲参数的 unit 和 si_unit 均填写 [1] -->
                <parameter name="[str]" value="[float]" unit="[str]" si_unit="[str]"/>
            </conductivity>
            <!-- 导热系数各模型的完整构造参数与状态依赖：
            <conductivity model="common.constant">
                <parameter name="constant_value" value="[float]" unit="[W]/[m][K]" si_unit="[W]/[m][K]"/>
            </conductivity>
            <conductivity model="common.time_series">
                <parameter name="times" value="[float] [float]" unit="[s]" si_unit="[s]"/>
                <parameter name="values" value="[float] [float]" unit="[W]/[m][K]" si_unit="[W]/[m][K]"/>
            </conductivity>
            <conductivity model="kernel.bison_2021_uco"/>
            <conductivity model="kernel.ineri_2004_uo2"/>
            <conductivity model="buffer.bison_2021">
                <parameter name="initial_mass_density" value="[float]" unit="[kg]/[m]^3" si_unit="[kg]/[m]^3"/>
            </conductivity>
            <conductivity model="buffer.uk_2004"/>
            <conductivity model="sic.miller"/>
            <conductivity model="sic.cea_2004"/>
            除 common.constant、common.time_series 和 buffer.bison_2021 外均无构造参数。
            common.time_series 依赖 external.time, 导热系数样本必须为正。
            kernel.bison_2021_uco / sic.miller 依赖 temperature；
            kernel.ineri_2004_uo2 依赖 temperature、burnup_fima_fraction、general.porosity；
            buffer.bison_2021 依赖 general.mass_density；buffer.uk_2004 依赖 general.porosity；
            sic.cea_2004 依赖 temperature、general.porosity。
            -->
            <!-- specific_heat 可选 common.constant、common.time_series、kernel.fink_2000_uo2、sic.bison_2021 -->
            <specific_heat model="common.constant">
                <parameter name="constant_value" value="[float]" unit="[J]/[kg][K]" si_unit="[J]/[kg][K]"/>
            </specific_heat>
            <!-- 如需随时间变化, 用下方节点替换上面的 specific_heat 节点
            <specific_heat model="common.time_series">
                <parameter name="times" value="[float] [float]" unit="[s]" si_unit="[s]"/>
                <parameter name="values" value="[float] [float]" unit="[J]/[kg][K]" si_unit="[J]/[kg][K]"/>
            </specific_heat>
            -->
            <!-- UO2 核心可用温度相关模型; 富集度为 0 到 1 的比例, 15.5% 填 0.155
            <specific_heat model="kernel.fink_2000_uo2">
                <parameter name="u235_enrichment" value="0.155" unit="[1]" si_unit="[1]"/>
            </specific_heat>
            -->
            <!-- SiC 可用温度相关模型, 不需要构造参数
            <specific_heat model="sic.bison_2021"/>
            -->
        </thermal>
        <!-- 不需要通用物性时可删除 general 节点 -->
        <general>
            <porosity model="common.constant">
                <parameter name="constant_value" value="[float]" unit="[1]" si_unit="[1]"/>
            </porosity>
            <!-- 如需随时间变化, 用下方节点替换上面的 porosity 节点
            <porosity model="common.time_series">
                <parameter name="times" value="[float] [float]" unit="[s]" si_unit="[s]"/>
                <parameter name="values" value="[float] [float]" unit="[1]" si_unit="[1]"/>
            </porosity>
            -->
            <mass_density model="common.constant">
                <parameter name="constant_value" value="[float]" unit="[kg]/[m]^3" si_unit="[kg]/[m]^3"/>
            </mass_density>
            <!-- 如需随时间变化, 用下方节点替换上面的 mass_density 节点
            <mass_density model="common.time_series">
                <parameter name="times" value="[float] [float]" unit="[s]" si_unit="[s]"/>
                <parameter name="values" value="[float] [float]" unit="[kg]/[m]^3" si_unit="[kg]/[m]^3"/>
            </mass_density>
            -->
        </general>
        <!-- 放射性物性分类可选；不求解核素时可删除 -->
        <radioactivity>
            <!-- 可选 common.constant、common.time_series、common.arrhenius，或下列 TECDOC-978 模型；
                 Arrhenius 和 TECDOC-978 模型依赖 temperature。
                 kernel.tecdoc978_frg：Cs、Sr、Ag、I、Kr、Xe；kernel.tecdoc978_japan：Cs。
                 pyc.tecdoc978_frg / pyc.tecdoc978_usa：Cs、Sr、Ag、Kr、Xe；
                 pyc.tecdoc978_japan：Cs；pyc.tecdoc978_russian：Ag、Kr。
                 sic.tecdoc978_frg：Cs、Sr、Ag；sic.tecdoc978_usa：Sr、Ag；
                 sic.tecdoc978_usa_lower / sic.tecdoc978_usa_upper：Cs；
                 sic.tecdoc978_japan：Cs、Sr、Ag、Xe；sic.tecdoc978_russian：Cs、Ag。
                 日本 PyC 的 Cs 在 1600°C 切换；日本 SiC 的 Xe 在 1400°C、1650°C 切换，Cs 在 1500°C 切换。
                 FRG SiC 的快中子注量 Γ 暂取 10^25 m^-2；日本 SiC 的 Cs 低温段取表中 D0 上限。 -->
            <nuclide_diffusion_coef model="common.arrhenius">
                <parameter name="D0" value="[float]" unit="[m]^2/[s]" si_unit="[m]^2/[s]"/>
                <parameter name="Q" value="[float]" unit="[J]/[mol]" si_unit="[J]/[mol]"/>
            </nuclide_diffusion_coef>
            <!-- 替代写法：D0 为正数，Q 非负；常数与时间表扩散系数非负。
            <nuclide_diffusion_coef model="common.constant">
                <parameter name="constant_value" value="[float]" unit="[m]^2/[s]" si_unit="[m]^2/[s]"/>
            </nuclide_diffusion_coef>
            <nuclide_diffusion_coef model="common.time_series">
                <parameter name="times" value="[float] [float]" unit="[s]" si_unit="[s]"/>
                <parameter name="values" value="[float] [float]" unit="[m]^2/[s]" si_unit="[m]^2/[s]"/>
            </nuclide_diffusion_coef>
            <nuclide_diffusion_coef model="kernel.tecdoc978_frg"/>
            <nuclide_diffusion_coef model="kernel.tecdoc978_japan"/>
            <nuclide_diffusion_coef model="pyc.tecdoc978_frg"/>
            <nuclide_diffusion_coef model="pyc.tecdoc978_usa"/>
            <nuclide_diffusion_coef model="pyc.tecdoc978_japan"/>
            <nuclide_diffusion_coef model="pyc.tecdoc978_russian"/>
            <nuclide_diffusion_coef model="sic.tecdoc978_frg"/>
            <nuclide_diffusion_coef model="sic.tecdoc978_usa"/>
            <nuclide_diffusion_coef model="sic.tecdoc978_usa_lower"/>
            <nuclide_diffusion_coef model="sic.tecdoc978_usa_upper"/>
            <nuclide_diffusion_coef model="sic.tecdoc978_japan"/>
            <nuclide_diffusion_coef model="sic.tecdoc978_russian"/>
            核素名称从 radioactivity 卡读取；以上仅为不同材料和核素的替代示例。
            -->
        </radioactivity>
    </mat>
    <assign>
        <!-- region 可重复, name 引用几何区域, mat 引用本卡材料 -->
        <region name="[str]" mat="[str]"/>
    </assign>
</material>
