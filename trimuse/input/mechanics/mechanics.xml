<?xml version="1.0" encoding="UTF-8"?>
<mechanics>
    <parameters>
        <parameter name="thermal_expansion_reference_temperature" value="273.15" unit="[K]" si_unit="[K]"/>
        <parameter name="gravity_acceleration" value="0 -9.81" unit="[m]/[s]^2" si_unit="[m]/[s]^2"/>
    </parameters>
    <regions>
        <!-- 省略 source 或 thermal_expansion 时，不组装相应项 -->
        <!-- 2D 重力向量为 [r,z] 且径向为 0；3D 为 [x,y,z]；1D 不支持固定方向重力 -->
        <region name="residual">
            <model name="stiffness" model_name="linear_elastic"/>
            <model name="thermal_expansion" model_name="linear"/>
            <model name="source" model_name="gravity"/>
        </region>
    </regions>
    <boundaries>
        <!-- 省略的外边界为零面力；边界数值在属性卡中配置 -->
        <!-- 正压力沿表面内法向，也可选 from_surface_traction 指定面力 -->
        <boundary name="[str]">
            <model name="mechanics_boundary" model_name="from_surface_pressure"/>
        </boundary>
        <boundary name="[str]">
            <model name="mechanics_boundary" model_name="from_surface_displacement"/>
        </boundary>
    </boundaries>
    <interfaces>
        <!-- 省略的内部界面默认完美粘结 -->
        <interface name="residual">
            <model name="interface_contact" model_name="perfect_contact"/>
        </interface>
        <!-- 压力值来自属性卡同名界面的 assembly.interface_pressure，加载不改变连接关系 -->
        <!-- 单侧写法，指定该界面相邻的受压区域 -->
        <!--
        <interface name="buffer_ipyc">
            <model name="interface_contact" model_name="perfect_contact"/>
            <model name="interface_pressure" model_name="single_face">
                <parameter name="region" value="ipyc" unit="[1]" si_unit="[1]"/>
            </model>
        </interface>
        -->
        <!-- 双侧写法，与上面的单侧写法二选一
        <interface name="buffer_ipyc">
            <model name="interface_contact" model_name="perfect_contact"/>
            <model name="interface_pressure" model_name="double_face"/>
        </interface>
        -->
    </interfaces>
</mechanics>
