<?xml version="1.0" encoding="UTF-8"?>
<!-- 按 global、材料 region 或外表面 zone 配置属性；zone 名称来自 geometry_mesh 的 zones -->
<!-- XML 的属性 name 保留短名; 程序内组成 external.xxx / derived.xxx。属性模型统一使用 common.xxx。 -->
<properties>
    <!-- 单次裂变释热能量，200 MeV 约为 3.20435e-11 J，仅支持 common.constant -->
    <external_property name="energy_per_fission">
        <global model="common.constant">
            <parameter name="constant_value" value="3.20435e-11" unit="[J]" si_unit="[J]"/>
        </global>
    </external_property>
    <!-- 各区域的初始重金属原子总数，固定不随燃耗减少，仅支持 common.constant -->
    <external_property name="initial_heavy_metal_inventory">
        <region name="[str]" model="common.constant">
            <parameter name="constant_value" value="[float]" unit="[atom]" si_unit="[atom]"/>
        </region>
    </external_property>
    <external_property name="power">
        <region name="[str]" model="common.time_series">
            <parameter name="times" value="[float] [float]" unit="[str]" si_unit="[s]"/>
            <parameter name="values" value="[float] [float]" unit="[str]" si_unit="[W]"/>
        </region>
        <!-- 常数模型可用于其他区域, 不使用时删除 -->
        <region name="[str]" model="common.constant">
            <parameter name="constant_value" value="[float]" unit="[str]" si_unit="[W]"/>
        </region>
    </external_property>
    <external_property name="environment_temperature">
        <zone name="[str]" model="common.constant">
            <parameter name="constant_value" value="[float]" unit="[str]" si_unit="[K]"/>
        </zone>
        <!-- 另一分区可使用 time_series，times/values 等长且 times 严格递增。
        <zone name="[str]" model="common.time_series">
            <parameter name="times" value="[float] [float]" unit="[s]" si_unit="[s]"/>
            <parameter name="values" value="[float] [float]" unit="[K]" si_unit="[K]"/>
        </zone>
        -->
    </external_property>
    <!-- Dirichlet 边界使用同名 zone 的 surface_temperature, 内部单位 K -->
    <external_property name="surface_temperature">
        <zone name="[str]" model="common.constant">
            <parameter name="constant_value" value="[float]" unit="[K]" si_unit="[K]"/>
        </zone>
        <!-- 时间表可替换上面的常数模型, 或用于另一分区; times 严格递增。
        <zone name="[str]" model="common.time_series">
            <parameter name="times" value="[float] [float]" unit="[s]" si_unit="[s]"/>
            <parameter name="values" value="[float] [float]" unit="[K]" si_unit="[K]"/>
        </zone>
        -->
    </external_property>
    <!-- Neumann 边界使用同名 zone 的 heat_flux, 单位 W/m²; 正值向外散热, 负值向内加热, 0 为绝热 -->
    <external_property name="heat_flux">
        <zone name="[str]" model="common.constant">
            <parameter name="constant_value" value="[float]" unit="[W]/[m]^2" si_unit="[W]/[m]^2"/>
        </zone>
        <!-- 时间表模型可替换上面的常数模型, 或用于另一个 zone; times 严格递增, values 可正可负。
        <zone name="[str]" model="common.time_series">
            <parameter name="times" value="[float] [float]" unit="[s]" si_unit="[s]"/>
            <parameter name="values" value="[float] [float]" unit="[W]/[m]^2" si_unit="[W]/[m]^2"/>
        </zone>
        -->
    </external_property>
    <!-- 核素 Dirichlet 边界: 同名 zone 的指定浓度, 内部单位 atom/m³, 数值非负 -->
    <!-- 核素数量可用 atom、mol 及相应前缀单位, si_unit 保持 atom 体系; 不支持活度单位 Bq/Ci -->
    <external_property name="surface_nuclide_concentration">
        <zone name="[str]" model="common.constant">
            <parameter name="constant_value" value="[float]" unit="[atom]/[m]^3" si_unit="[atom]/[m]^3"/>
        </zone>
        <!-- 时间表可替换上面的常数模型; times 严格递增, values 非负。
        <zone name="[str]" model="common.time_series">
            <parameter name="times" value="[float] [float]" unit="[s]" si_unit="[s]"/>
            <parameter name="values" value="[float] [float]" unit="[atom]/[m]^3" si_unit="[atom]/[m]^3"/>
        </zone>
        -->
    </external_property>
    <!-- 核素 Neumann 边界: 正值向外释放, 负值向内输入, 0 为无通量 -->
    <external_property name="nuclide_flux">
        <zone name="[str]" model="common.constant">
            <parameter name="constant_value" value="[float]" unit="[atom]/[m]^2[s]" si_unit="[atom]/[m]^2[s]"/>
        </zone>
        <!-- 时间表可替换上面的常数模型; values 可正可负。
        <zone name="[str]" model="common.time_series">
            <parameter name="times" value="[float] [float]" unit="[s]" si_unit="[s]"/>
            <parameter name="values" value="[float] [float]" unit="[atom]/[m]^2[s]" si_unit="[atom]/[m]^2[s]"/>
        </zone>
        -->
    </external_property>
    <!-- 当前区域体积，common.undeformed 直接使用 precomputed.initial_region_volume -->
    <derived_property name="region_volume">
        <region name="[str]" model="common.undeformed"/>
    </derived_property>
    <!-- burnup_fima_fraction 使用 0 到 1 的 FIMA 份额, 例如 0.2 表示 20% FIMA -->
    <derived_property name="burnup_fima_fraction">
        <!-- 按区域平均体积裂变率、当前体积和初始重金属盘存累积 FIMA，initial_value 为初始份额 -->
        <region name="[str]" model="common.accumulate_from_fission_rate">
            <parameter name="initial_value" value="0" unit="[1]" si_unit="[1]"/>
        </region>
        <!-- 也可使用常数或时间表替换上面的 region
        <region name="[str]" model="common.constant">
            <parameter name="constant_value" value="[float]" unit="[1]" si_unit="[1]"/>
        </region>
        <region name="[str]" model="common.time_series">
            <parameter name="times" value="[float] [float]" unit="[s]" si_unit="[s]"/>
            <parameter name="values" value="[float] [float]" unit="[1]" si_unit="[1]"/>
        </region>
        -->
    </derived_property>
    <derived_property name="average_volumetric_fission_rate">
        <!-- 区域总裂变释热功率 / 当前区域体积 / 全局单次裂变释热能量 -->
        <region name="[str]" model="common.from_power"/>
        <!-- 直接指定区域平均体积裂变率时，用下方 constant 或 time_series 替换上面的 region
        <region name="[str]" model="common.constant">
            <parameter name="constant_value" value="[float]" unit="[1]/[m]^3[s]" si_unit="[1]/[m]^3[s]"/>
        </region>
        <region name="[str]" model="common.time_series">
            <parameter name="times" value="[float] [float]" unit="[s]" si_unit="[s]"/>
            <parameter name="values" value="[float] [float]" unit="[1]/[m]^3[s]" si_unit="[1]/[m]^3[s]"/>
        </region>
        -->
    </derived_property>
    <derived_property name="fission_gas_production_rate">
        <!-- 区域裂变气体总产生率：0.297 × average_volumetric_fission_rate × region_volume / N_A，单位 mol/s -->
        <region name="[str]" model="kernel.bison_2021"/>
        <!-- 直接指定产生率时，用下方 constant 或 time_series 替换上面的 region
        <region name="[str]" model="common.constant">
            <parameter name="constant_value" value="[float]" unit="[mol]/[s]" si_unit="[mol]/[s]"/>
        </region>
        <region name="[str]" model="common.time_series">
            <parameter name="times" value="[float] [float]" unit="[s]" si_unit="[s]"/>
            <parameter name="values" value="[float] [float]" unit="[mol]/[s]" si_unit="[mol]/[s]"/>
        </region>
        -->
    </derived_property>
    <derived_property name="volumetric_power">
        <!-- 可选 common.constant、common.time_series、common.uniform_from_power -->
        <!-- 仅 common.uniform_from_power 需要同一区域的 external.power 和 derived.region_volume -->
        <region name="[str]" model="common.uniform_from_power"/>
        <!-- 直接给定体积功率密度时, 用下列常数或时间表模型替换上面的 region, 不需要 external.power。
        <region name="[str]" model="common.constant">
            <parameter name="constant_value" value="[float]" unit="[W]/[m]^3" si_unit="[W]/[m]^3"/>
        </region>
        <region name="[str]" model="common.time_series">
            <parameter name="times" value="[float] [float]" unit="[s]" si_unit="[s]"/>
            <parameter name="values" value="[float] [float]" unit="[W]/[m]^3" si_unit="[W]/[m]^3"/>
        </region>
        -->
    </derived_property>
    <derived_property name="heat_transfer_coef">
        <zone name="[str]" model="common.constant">
            <parameter name="constant_value" value="[float]" unit="[str]" si_unit="[W]/[m]^2[K]"/>
        </zone>
        <!-- 时间变化模型可替换上面的常数模型，或用于另一个 zone。
        <zone name="[str]" model="common.time_series">
            <parameter name="times" value="[float] [float]" unit="[s]" si_unit="[s]"/>
            <parameter name="values" value="[float] [float]" unit="[W]/[m]^2[K]" si_unit="[W]/[m]^2[K]"/>
        </zone>
        -->
    </derived_property>
    <external_property name="fast_neutron_flux">
        <global model="common.constant">
            <parameter name="constant_value" value="[float]" unit="[1]/[m]^2[s]" si_unit="[1]/[m]^2[s]"/>
        </global>
        <!-- 如需时间表，替换上面的 global 节点；times/values 等长且至少两个点，times 严格递增。
        <global model="common.time_series">
            <parameter name="times" value="[float] [float]" unit="[s]" si_unit="[s]"/>
            <parameter name="values" value="[float] [float]" unit="[1]/[m]^2[s]" si_unit="[1]/[m]^2[s]"/>
        </global>
        -->
    </external_property>
    <derived_property name="irradiation_time">
        <!-- 通量大于零时累积；若需无条件累积，将 model 改为 common.accumulate -->
        <global model="common.accumulate_from_fast_neutron_flux">
            <parameter name="initial_value" value="0" unit="[s]" si_unit="[s]"/>
        </global>
    </derived_property>
    <derived_property name="fast_neutron_fluence">
        <!-- 从 initial_value 开始按时间步累加当前时刻的快中子通量，单位 1/m² -->
        <global model="common.accumulate_from_fast_neutron_flux">
            <parameter name="initial_value" value="0" unit="[1]/[m]^2" si_unit="[1]/[m]^2"/>
        </global>
        <!-- 也可用常数或时间表直接指定注量，替换上面的 global 节点。
        <global model="common.constant">
            <parameter name="constant_value" value="[float]" unit="[1]/[m]^2" si_unit="[1]/[m]^2"/>
        </global>
        <global model="common.time_series">
            <parameter name="times" value="[float] [float]" unit="[s]" si_unit="[s]"/>
            <parameter name="values" value="[float] [float]" unit="[1]/[m]^2" si_unit="[1]/[m]^2"/>
        </global>
        -->
    </derived_property>
    <external_property name="nuclide_birth_rate">
        <global model="common.constant">
            <parameter name="constant_value" value="[float]" unit="[atom]/[s]" si_unit="[atom]/[s]"/>
        </global>
        <!-- 如需时间表，替换上面的节点；times/values 等长且至少两个点，times 严格递增。
        <global model="common.time_series">
            <parameter name="times" value="[float] [float]" unit="[s]" si_unit="[s]"/>
            <parameter name="values" value="[float] [float]" unit="[atom]/[s]" si_unit="[atom]/[s]"/>
        </global>
        -->
    </external_property>
    <external_property name="uranium_fraction">
        <region name="[str]" model="common.constant">
            <parameter name="constant_value" value="[float]" unit="[1]" si_unit="[1]"/>
        </region>
        <!-- 如需时间表，替换上面的节点；times/values 等长且至少两个点，times 严格递增。
        <region name="[str]" model="common.time_series">
            <parameter name="times" value="[float] [float]" unit="[s]" si_unit="[s]"/>
            <parameter name="values" value="[float] [float]" unit="[1]" si_unit="[1]"/>
        </region>
        -->
    </external_property>
    <external_property name="environment_nuclide_concentration">
        <zone name="[str]" model="common.constant">
            <parameter name="constant_value" value="[float]" unit="[atom]/[m]^3" si_unit="[atom]/[m]^3"/>
        </zone>
        <!-- 如需时间表，替换上面的节点；times/values 等长且至少两个点，times 严格递增。
        <zone name="[str]" model="common.time_series">
            <parameter name="times" value="[float] [float]" unit="[s]" si_unit="[s]"/>
            <parameter name="values" value="[float] [float]" unit="[atom]/[m]^3" si_unit="[atom]/[m]^3"/>
        </zone>
        -->
    </external_property>
    <!-- nuclide_birth_rate 为全局产生率；uranium_fraction 为各区域分配份额（0 到 1），不是材料铀含量。
         所有核素数量类参数只接受 atom、mol 等数量单位，不接受 Bq/Ci。
         mass_transfer_coef 为 Robin 传质系数；表面浓度单位 atom/m³。
         constant 只需 constant_value；time_series 只需 times 和 values。
         时间表在点间线性插值，超出表格范围取最近端点值。 -->
    <derived_property name="mass_transfer_coef">
        <zone name="[str]" model="common.constant">
            <parameter name="constant_value" value="[float]" unit="[m]/[s]" si_unit="[m]/[s]"/>
        </zone>
        <!-- 如需时间表，替换上面的节点；times/values 等长且至少两个点，times 严格递增。
        <zone name="[str]" model="common.time_series">
            <parameter name="times" value="[float] [float]" unit="[s]" si_unit="[s]"/>
            <parameter name="values" value="[float] [float]" unit="[m]/[s]" si_unit="[m]/[s]"/>
        </zone>
        -->
    </derived_property>
    <derived_property name="volumetric_nuclide_birth_rate">
        <!-- 此模型无构造参数：全局 nuclide_birth_rate × 本区域 uranium_fraction / region_volume -->
        <region name="[str]" model="common.uniform_from_birth_rate"/>
        <!-- 也可直接给定体积产生率，替换上面的 region：
        <region name="[str]" model="common.constant">
            <parameter name="constant_value" value="[float]" unit="[atom]/[m]^3[s]" si_unit="[atom]/[m]^3[s]"/>
        </region>
        <region name="[str]" model="common.time_series">
            <parameter name="times" value="[float] [float]" unit="[s]" si_unit="[s]"/>
            <parameter name="values" value="[float] [float]" unit="[atom]/[m]^3[s]" si_unit="[atom]/[m]^3[s]"/>
        </region>
        -->
    </derived_property>
    <!-- 力学表面向量：1D [r]、2D [r,z]、3D [x,y,z]，以下向量示例采用 2D -->
    <!-- time_series 的 values 按时刻平铺，例如 [r0,z0,r1,z1] -->
    <!-- 指定求解坐标系下的面力分量 -->
    <external_property name="surface_traction">
        <zone name="[str]" model="common.constant">
            <parameter name="constant_value" value="[float] [float]" unit="[Pa]" si_unit="[Pa]"/>
        </zone>
        <!-- 时间表模型可替换上面的常数模型，times 严格递增
        <zone name="[str]" model="common.time_series">
            <parameter name="times" value="[float] [float]" unit="[s]" si_unit="[s]"/>
            <parameter name="values" value="[float] [float] [float] [float]" unit="[Pa]" si_unit="[Pa]"/>
        </zone>
        -->
    </external_property>
    <!-- 指定求解坐标系下的位移分量 -->
    <external_property name="surface_displacement">
        <zone name="[str]" model="common.constant">
            <parameter name="constant_value" value="[float] [float]" unit="[m]" si_unit="[m]"/>
        </zone>
        <!-- 时间表模型可替换上面的常数模型，times 严格递增
        <zone name="[str]" model="common.time_series">
            <parameter name="times" value="[float] [float]" unit="[s]" si_unit="[s]"/>
            <parameter name="values" value="[float] [float] [float] [float]" unit="[m]" si_unit="[m]"/>
        </zone>
        -->
    </external_property>
    <!-- 压力为标量，正值沿表面内法向加载 -->
    <external_property name="surface_pressure">
        <zone name="[str]" model="common.constant">
            <parameter name="constant_value" value="[float]" unit="[Pa]" si_unit="[Pa]"/>
        </zone>
        <!-- 时间表模型可替换上面的常数模型，times 严格递增
        <zone name="[str]" model="common.time_series">
            <parameter name="times" value="[float] [float]" unit="[s]" si_unit="[s]"/>
            <parameter name="values" value="[float] [float]" unit="[Pa]" si_unit="[Pa]"/>
        </zone>
        -->
    </external_property>
    <!-- 按同名内部界面配置单位面积热阻，角域外采用完美接触 -->
    <assembly_property name="interface_thermal_resistance">
        <interface name="[str]" model="common.uniform_from_constant_value">
            <parameter name="constant_value" value="[float]" unit="[m]^2[K]/[W]" si_unit="[m]^2[K]/[W]"/>
        </interface>
        <!-- 2D 从上极点起算，热阻与角度区间列表逐项对应 -->
        <interface name="[str]" model="common.local_from_constant_value">
            <parameter name="constant_value" value="[float] [float]" unit="[m]^2[K]/[W]" si_unit="[m]^2[K]/[W]"/>
            <parameter name="theta_mins" value="10 60" unit="[degree]" si_unit="[rad]"/>
            <parameter name="theta_maxs" value="15 65" unit="[degree]" si_unit="[rad]"/>
        </interface>
        <!-- 3D 写法，thetas 和 phis 给出中心方向，角距离相对该方向计算
        <interface name="[str]" model="common.local_from_constant_value">
            <parameter name="constant_value" value="[float] [float]" unit="[m]^2[K]/[W]" si_unit="[m]^2[K]/[W]"/>
            <parameter name="thetas" value="30 90" unit="[degree]" si_unit="[rad]"/>
            <parameter name="phis" value="0 180" unit="[degree]" si_unit="[rad]"/>
            <parameter name="angular_distance_mins" value="0 10" unit="[degree]" si_unit="[rad]"/>
            <parameter name="angular_distance_maxs" value="15 20" unit="[degree]" si_unit="[rad]"/>
        </interface>
        -->
    </assembly_property>
    <!-- 压力的空间分布独立于力学卡中的单侧或双侧加载方式，region 参数只放在力学卡中 -->
    <!--
    <assembly_property name="interface_pressure">
        <interface name="buffer_ipyc" model="uniform_from_constant_value">
            <parameter name="constant_value" value="10" unit="[MPa]" si_unit="[Pa]"/>
        </interface>
    </assembly_property>
    -->
    <!-- 局部压力写法，可替换上面的均匀压力配置，角域外压力为零
    <assembly_property name="interface_pressure">
        <interface name="buffer_ipyc" model="local_from_constant_value">
            <parameter name="constant_value" value="10 20" unit="[MPa]" si_unit="[Pa]"/>
            <parameter name="theta_mins" value="0 90" unit="[degree]" si_unit="[rad]"/>
            <parameter name="theta_maxs" value="45 135" unit="[degree]" si_unit="[rad]"/>
        </interface>
    </assembly_property>
    -->
    <!-- 精细版本：按求积点记录释放历史并积分，状态属性由程序自动配置，累计释放量单位为 mol -->
    <assembly_property name="cumulative_fission_gas_release">
        <region name="[str]" model="common.from_local_booth_fission_gas_release">
            <parameter name="mode_count" value="100" unit="[1]" si_unit="[1]"/>
            <parameter name="grain_radius" value="1e-5" unit="[m]" si_unit="[m]"/>
        </region>
    </assembly_property>
    <!-- 均匀化版本：以区域平均扩散系数推进一套历史，可替换上面的精细版本
    <assembly_property name="cumulative_fission_gas_release">
        <region name="[str]" model="common.from_homogenized_booth_fission_gas_release">
            <parameter name="mode_count" value="100" unit="[1]" si_unit="[1]"/>
            <parameter name="grain_radius" value="1e-5" unit="[m]" si_unit="[m]"/>
        </region>
    </assembly_property>
    -->
</properties>
