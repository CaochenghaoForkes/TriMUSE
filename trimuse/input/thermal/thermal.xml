<?xml version="1.0" encoding="UTF-8"?>
<thermal>
    <!-- 当前热问题没有专属参数，可省略 parameters -->
    <initial>
        <temperature region="residual" model="uniform">
            <parameter name="uniform_value" value="[float]" unit="[str]" si_unit="[K]"/>
        </temperature>
    </initial>
    <regions>
        <!-- 单独配置的区域列出其全部组装项，residual 应用于其余区域 -->
        <!-- source 可省略；volumetric_power 读取属性卡中的派生量；稳态可省略 capacity -->
        <region name="residual">
            <model name="conduction" model_name="fourier"/>
            <model name="capacity" model_name="rho_cp"/>
        </region>
    </regions>
    <boundaries>
        <!-- 省略的外边界为零热通量 -->
        <!-- robin 读取同名分区的环境温度与换热系数；另可选 dirichlet 或 neumann -->
        <boundary name="[str]">
            <model name="heat_boundary" model_name="robin"/>
        </boundary>
    </boundaries>
    <interfaces>
        <!-- 默认完美接触；热阻界面读取属性卡同名界面的热阻，温度场使用 continuity="region" -->
        <interface name="[str]">
            <model name="interface_heat_transfer" model_name="interface_thermal_resistance"/>
        </interface>
    </interfaces>
</thermal>
