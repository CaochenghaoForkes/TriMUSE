<?xml version="1.0" encoding="UTF-8"?>
<simulation>

    <problem>
        <!-- 各段持续时间; 累计终点 0.02、0.10、0.50 s -->
        <!-- alpha=8e-7 m^2/s, 主要时间常数约 0.12665 s; 末时刻球心达到约 98.5% 稳态温升 -->
        <time_span value="0.02 0.08 0.40" unit="[s]"/>
        <!-- 前期细步长捕捉热源突然开启, 共 40+80+200=320 个推进步 -->
        <min_time_step value="0.0005 0.001 0.002" unit="[s]"/>
        <!-- 后向欧拉; 修改 theta 可进一步验证其他时间离散格式 -->
        <field name="thermal" model="transient" theta="1.0"/>
    </problem>

    <solver>
        <quadrature domain_order="4" boundary_order="3"/>
        <field name="thermal">
            <fem_space family="H1" order="1"/>
            <linear_solver method="cg" preconditioner="none" relative_tolerance="1e-9" max_iterations="5000"/>
            <nonlinear_solver method="picard" relative_tolerance="1e-6" max_iterations="50">
                <absolute_tolerance value="1e-4" unit="[K]"/>
            </nonlinear_solver>
        </field>
    </solver>

    <coupling exchange_interval="1 1 1">
        <step fields="thermal" method="single"/>
    </coupling>

    <output>
        <!-- 全程每 0.002 s 保存一次, 各阶段终点均落在输出时刻; 含初始时刻共 251 帧 -->
        <write_interval value="0.002 0.002 0.002" unit="[s]"/>
    </output>

</simulation>
