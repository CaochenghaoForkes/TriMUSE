<?xml version="1.0" encoding="UTF-8"?>
<properties>

    <!-- t=0 后北极热区施加指定热通量 (Neumann), 其余表面与冷环境对流换热 (Robin) -->
    <!-- heat_flux 按外法向为正: 正值散热, 负值加热; 单位 W/m², 不是总功率 W -->
    <!-- 人为设定的局部加热测试边界, 不对应已标定工况; 本例不包含辐射 -->
    <external_property name="heat_flux">
        <zone name="heat_zone" model="constant">
            <parameter name="constant_value" value="-1e7" unit="[W]/[m]^2" si_unit="[W]/[m]^2"/>
        </zone>
    </external_property>

    <external_property name="environment_temperature">
        <zone name="cold_zone" model="constant">
            <parameter name="constant_value" value="573.15" unit="[K]" si_unit="[K]"/>
        </zone>
    </external_property>

    <derived_property name="heat_transfer_coef">
        <zone name="cold_zone" model="constant">
            <parameter name="constant_value" value="500.0" unit="[W]/[m]^2[K]" si_unit="[W]/[m]^2[K]"/>
        </zone>
    </derived_property>

    <!-- 无内热源, 不安排 power 或 volumetric_power; 当前材料也不需要燃耗输入 -->
</properties>
