<?xml version="1.0" encoding="UTF-8"?>
<geometry_mesh>
    <model dimension="1"/>
    <geometry source="ideal_multilayer_sphere">
        <ideal_multilayer_sphere>
            <center>
                <x value="0.0" unit="[um]"/>
            </center>
            <layers>
                <layer name="fuel_region">
                    <outer_boundary name="interface"/>
                    <outer_radius value="500" unit="[um]"/>
                </layer>
                <layer name="non_fuel_region">
                    <outer_boundary name="outer_boundary"/>
                    <outer_radius value="1000" unit="[um]"/>
                </layer>
            </layers>
        </ideal_multilayer_sphere>
        <surface_zones outer_boundary="outer_boundary">
            <residual_zone name="surface_zone"/>
        </surface_zones>
    </geometry>
    <mesh>
        <element geometry_order="1"/>
        <sizing>
            <!-- 核心较粗、包覆层较细; 目标尺寸不是实际边长或厚度方向单元数的严格约束 -->
            <global>
                <min_edge_length value="8.0" unit="[um]"/>
                <max_edge_length value="30.0" unit="[um]"/>
            </global>
            <region name="fuel_region"><target_edge_length value="30.0" unit="[um]"/></region>
            <region name="non_fuel_region"><target_edge_length value="20.0" unit="[um]"/></region>
        </sizing>
        <gmsh algorithm_3d="hxt" optimizer="gmsh"/>
    </mesh>
</geometry_mesh>
