<?xml version="1.0" encoding="UTF-8"?>
<thermal>

    <initial>
        <temperature region="kernel" model="uniform">
            <parameter name="uniform_value" value="293.15" unit="[K]" si_unit="[K]"/>
        </temperature>
        <temperature region="buffer" model="uniform">
            <parameter name="uniform_value" value="293.15" unit="[K]" si_unit="[K]"/>
        </temperature>
        <temperature region="ipyc" model="uniform">
            <parameter name="uniform_value" value="293.15" unit="[K]" si_unit="[K]"/>
        </temperature>
        <temperature region="sic" model="uniform">
            <parameter name="uniform_value" value="293.15" unit="[K]" si_unit="[K]"/>
        </temperature>
        <temperature region="opyc" model="uniform">
            <parameter name="uniform_value" value="293.15" unit="[K]" si_unit="[K]"/>
        </temperature>
    </initial>

    <boundaries>
        <boundary name="heat_zone" model="robin"/>
    </boundaries>

    <interfaces>
        <interface name="kernel_buffer" model="perfect_contact"/>
        <interface name="buffer_ipyc" model="perfect_contact"/>
        <interface name="ipyc_sic" model="perfect_contact"/>
        <interface name="sic_opyc" model="perfect_contact"/>
    </interfaces>

</thermal>
