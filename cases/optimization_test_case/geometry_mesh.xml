<?xml version="1.0" encoding="UTF-8"?>
<geometry_mesh>
    <!-- 二维轴对称右半截面, 绕 y 轴旋转; 功率仍为整个三维球体核心的总功率 -->
    <model dimension="2"/>
    <geometry source="ideal_multilayer_sphere">
        <ideal_multilayer_sphere>
            <center>
                <x value="0.0" unit="[um]"/>
                <y value="0.0" unit="[um]"/>
            </center>
            <regions>
                <region name="fuel_region">
                    <outer_boundary name="interface"/>
                    <outer_radius value="500" unit="[um]"/>
                </region>
                <region name="non_fuel_region">
                    <outer_boundary name="outer_boundary"/>
                    <outer_radius value="1000" unit="[um]"/>
                </region>
            </regions>
        </ideal_multilayer_sphere>
        <zones outer_boundary="outer_boundary">
            <zone name="heat_zone">
                <theta_min value="0.0" unit="[degree]"/>
                <theta_max value="90.0" unit="[degree]"/>
            </zone>
            <residual_zone name="cold_zone"/>
        </zones>
    </geometry>
    <mesh>
        <element geometry_order="2"/>
        <sizing>
            <!-- 二次曲边几何逼近圆弧; H1 场仍为一次; 目标尺寸不等于严格单元边长 -->
            <global>
                <min_edge_length value="8.0" unit="[um]"/>
                <max_edge_length value="30.0" unit="[um]"/>
            </global>
            <region name="fuel_region"><target_edge_length value="30.0" unit="[um]"/></region>
            <region name="non_fuel_region"><target_edge_length value="20.0" unit="[um]"/></region>
        </sizing>
        <gmsh algorithm_3d="hxt" optimizer="gmsh"/>
        <output formats="vtk bdf"/>
    </mesh>
</geometry_mesh>
