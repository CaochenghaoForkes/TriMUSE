<?xml version="1.0" encoding="UTF-8"?>
<simulation>

    <problem>
        <!-- 各阶段持续时间, 累计终点为 0.01、0.10、2.00 s -->
        <time_span value="0.01 0.09 1.90" unit="[s]"/>
        <!-- 前期细步长捕捉核心升温, 后期逐步增大; 共 285 步 -->
        <min_time_step value="0.0002 0.002 0.01" unit="[s]"/>
        <!-- 恒定内热源开启后的瞬态, 使用后向欧拉 -->
        <field name="thermal" model="transient" theta="1.0"/>
    </problem>

    <solver>
        <!-- 二维三角形, 场插值阶次与网格几何阶次分别设置 -->
        <quadrature domain_order="4" boundary_order="3"/>
        <field name="thermal">
            <fem_space family="H1" order="1"/>
            <linear_solver method="cg" preconditioner="none" relative_tolerance="1e-9" max_iterations="5000"/>
            <nonlinear_solver method="picard" relative_tolerance="1e-6" max_iterations="50">
                <absolute_tolerance value="1e-4" unit="[K]"/>
            </nonlinear_solver>
        </field>
    </solver>

    <coupling exchange_interval="1 1 1">
        <step fields="thermal" method="single"/>
    </coupling>

    <output>
        <!-- 每个阶段按基础时间步计数; 初始时刻和阶段终点额外保存 -->
        <!-- 当前仅输出 thermal/temperature 的 ParaView 时间序列 -->
        <!-- 对应每 0.0002、0.002、0.02 s 保存, 共 191 帧 -->
        <write_interval value="1 1 2"/>
    </output>

</simulation>
