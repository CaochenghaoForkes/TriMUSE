<?xml version="1.0" encoding="UTF-8"?>
<material>

    <!-- UO2: 沿用基于 UO2 数据的 BISON 导热率相关式, 热容为富集度修正摩尔质量后的 Fink 模型 -->

    <mat name="uo2">
        <thermal>
            <conductivity model="kernel.bison_2021_uco"/>
            <specific_heat model="kernel.fink_2000_uo2">
                <parameter name="u235_enrichment" value="0.155" unit="[1]" si_unit="[1]"/>
            </specific_heat>
        </thermal>
        <general>
            <porosity model="common.constant">
                <parameter name="constant_value" value="0.0" unit="[1]" si_unit="[1]"/>
            </porosity>
            <mass_density model="common.constant">
                <parameter name="constant_value" value="10.96" unit="[g]/[cm]^3" si_unit="[kg]/[m]^3"/>
            </mass_density>
        </general>
    </mat>
    <!-- Buffer: BISON/PARFUME 密度相关导热率; 初始密度 1050 kg/m³ 对应 k=0.5 W/(m K) -->
    <mat name="buffer">
        <thermal>
            <conductivity model="buffer.bison_2021">
                <parameter name="initial_mass_density" value="1050.0" unit="[kg]/[m]^3" si_unit="[kg]/[m]^3"/>
            </conductivity>
            <specific_heat model="common.constant">
                <parameter name="constant_value" value="720.0" unit="[J]/[kg][K]" si_unit="[J]/[kg][K]"/>
            </specific_heat>
        </thermal>
        <general>
            <porosity model="common.constant">
                <parameter name="constant_value" value="0.5333333333333333" unit="[1]" si_unit="[1]"/>
            </porosity>
            <mass_density model="common.constant">
                <parameter name="constant_value" value="1.05" unit="[g]/[cm]^3" si_unit="[kg]/[m]^3"/>
            </mass_density>
        </general>
    </mat>
    <!-- PyC: BISON 常用常数近似 k=4 W/(m K), cp=720 J/(kg K); rho=1900 kg/m³ -->
    <mat name="pyc">
        <thermal>
            <conductivity model="common.constant">
                <parameter name="constant_value" value="4.0" unit="[W]/[m][K]" si_unit="[W]/[m][K]"/>
            </conductivity>
            <specific_heat model="common.constant">
                <parameter name="constant_value" value="720.0" unit="[J]/[kg][K]" si_unit="[J]/[kg][K]"/>
            </specific_heat>
        </thermal>
        <general>
            <mass_density model="common.constant">
                <parameter name="constant_value" value="1.9" unit="[g]/[cm]^3" si_unit="[kg]/[m]^3"/>
            </mass_density>
        </general>
    </mat>
    <!-- SiC: Miller 导热率和 BISON 温度相关热容; 本例密度均为常数, 不考虑热膨胀 -->
    <mat name="sic">
        <thermal>
            <conductivity model="sic.miller"/>
            <specific_heat model="sic.bison_2021"/>
        </thermal>
        <general>
            <porosity model="common.constant">
                <parameter name="constant_value" value="0.0" unit="[1]" si_unit="[1]"/>
            </porosity>
            <mass_density model="common.constant">
                <parameter name="constant_value" value="3.2" unit="[g]/[cm]^3" si_unit="[kg]/[m]^3"/>
            </mass_density>
        </general>
    </mat>

    <assign>
        <region name="kernel" mat="uo2"/>
        <region name="buffer" mat="buffer"/>
        <region name="ipyc" mat="pyc"/>
        <region name="sic" mat="sic"/>
        <region name="opyc" mat="pyc"/>
    </assign>

</material>
