<?xml version="1.0" encoding="UTF-8"?>
<postprocess>
    <!-- 与一维算例相同的径向位置: r=250、750 um -->
    <points>
        <!-- 球心用于观察最明显的升温过程 -->
        <point name="center">
            <center>
                <x value="0.0" unit="[um]"/>
                <y value="0.0" unit="[um]"/>
                <z value="0.0" unit="[um]"/>
            </center>
        </point>
        <point name="fuel">
            <center>
                <x value="250" unit="[um]"/>
                <y value="0.0" unit="[um]"/>
                <z value="0.0" unit="[um]"/>
            </center>
        </point>
        <point name="non_fuel">
            <center>
                <x value="750" unit="[um]"/>
                <y value="0.0" unit="[um]"/>
                <z value="0.0" unit="[um]"/>
            </center>
        </point>
    </points>
    <!-- 从颗粒中心沿 +x 方向采样, 便于与 T(r) 解析解比较 -->
    <lines>
        <line name="radial" sample_count="100">
            <direction>
                <!-- 三维 theta 从 +z 起算, phi 绕 z 轴 -->
                <theta value="90.0" unit="[degree]"/>
                <phi value="0.0" unit="[degree]"/>
            </direction>
        </line>
    </lines>
    <!-- z=0 的赤道截面, 法线沿 +z -->
    <sections>
        <section name="equatorial_xy">
            <center>
                <x value="0.0" unit="[um]"/>
                <y value="0.0" unit="[um]"/>
                <z value="0.0" unit="[um]"/>
            </center>
            <normal>
                <theta value="0.0" unit="[degree]"/>
                <phi value="0.0" unit="[degree]"/>
            </normal>
        </section>
    </sections>
    <properties names="temperature"/>
</postprocess>
