<?xml version="1.0" encoding="UTF-8"?>
<simulation>

    <problem>
        <time_span value="0.2" unit="[s]"/>
        <min_time_step value="0.001" unit="[s]"/>
        <field name="temperature" model="transient" theta="1.0"/>
    </problem>

    <solver>
        <quadrature domain_order="4" boundary_order="3"/>
        <field name="temperature">
            <fem_space family="H1" order="1"/>
            <linear_solver method="cg" preconditioner="none" relative_tolerance="1e-9" max_iterations="5000"/>
            <nonlinear_solver method="picard" relative_tolerance="1e-7" max_iterations="50">
                <absolute_tolerance value="1e-4" unit="[K]"/>
            </nonlinear_solver>
        </field>
    </solver>

    <coupling exchange_interval="1">
        <step fields="temperature" method="single"/>
    </coupling>

    <output>
        <write_interval value="0.001" unit="[s]"/>
    </output>

</simulation>
